COURSE_NOTE_PROVIDER=ollama
COURSE_NOTE_LLM_TIMEOUT_SECONDS=120

# Shared fallback model. Provider-specific MODEL values override this.
COURSE_NOTE_MODEL=qwen2.5:7b

# Ollama
COURSE_NOTE_OLLAMA_HOST=127.0.0.1
COURSE_NOTE_OLLAMA_PORT=11434
COURSE_NOTE_OLLAMA_MODEL=qwen2.5:7b
# COURSE_NOTE_OLLAMA_API_BASE=http://127.0.0.1:11434/v1
# COURSE_NOTE_OLLAMA_API_KEY=ollama

# llama.cpp server
COURSE_NOTE_LLAMACPP_HOST=127.0.0.1
COURSE_NOTE_LLAMACPP_PORT=8080
COURSE_NOTE_LLAMACPP_MODEL=Qwen/Qwen2.5-7B-Instruct
# COURSE_NOTE_LLAMACPP_API_BASE=http://127.0.0.1:8080/v1
# COURSE_NOTE_LLAMACPP_API_KEY=EMPTY

# vLLM
COURSE_NOTE_VLLM_HOST=127.0.0.1
COURSE_NOTE_VLLM_PORT=8000
COURSE_NOTE_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# COURSE_NOTE_VLLM_API_BASE=http://127.0.0.1:8000/v1
# COURSE_NOTE_VLLM_API_KEY=EMPTY

# ZAI / BigModel
# COURSE_NOTE_PROVIDER=zai
# COURSE_NOTE_ZAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# COURSE_NOTE_ZAI_API_KEY=your_api_key
# COURSE_NOTE_ZAI_MODEL=glm-4.5-air

# Legacy compatibility. Prefer the provider-specific variables above.
# COURSE_NOTE_API_BASE=http://127.0.0.1:11434/v1
# COURSE_NOTE_API_KEY=ollama

# HackMD
# HACKMD_API=your_hackmd_token
